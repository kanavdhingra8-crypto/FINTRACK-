# Auth service
NODE_ENV=development
PORT=4001
AUTH_MONGODB_URI=mongodb://mongo:27017/fintrack_auth
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=10
LOG_LEVEL=info

# Transaction service
TRANSACTION_PORT=4002
TRANSACTION_MONGODB_URI=mongodb://mongo:27017/fintrack_transactions

# RabbitMQ
RABBITMQ_DEFAULT_USER=fintrack
RABBITMQ_DEFAULT_PASS=replace-with-a-local-password
RABBITMQ_URL=amqp://fintrack:replace-with-a-local-password@rabbitmq:5672
RABBITMQ_EXPENSE_QUEUE=fintrack.expense.created
RABBITMQ_CONNECT_TIMEOUT_MS=2000
RABBITMQ_PUBLISH_TIMEOUT_MS=2000
RABBITMQ_RECONNECT_DELAY_MS=3000
RABBITMQ_RETRY_DELAY_MS=1000

# API gateway
GATEWAY_PORT=4000
AUTH_SERVICE_URL=http://auth-service:4001
TRANSACTION_SERVICE_URL=http://transaction-service:4002
NOTIFICATION_SERVICE_URL=http://notification-service:4003
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Notification service
NOTIFICATION_PORT=4003
NOTIFICATION_MONGODB_URI=mongodb://mongo:27017/fintrack_notifications
DEFAULT_EXPENSE_THRESHOLD=10000

# Frontend (Vite reads this at build time; localhost is the user's browser)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000/api

# Demo seed (the Compose seed job calls the gateway internally)
SEED_API_URL=http://gateway:4000/api
DEMO_EMAIL=demo@fintrack.com
DEMO_PASSWORD=Demo@1234
